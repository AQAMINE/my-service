# Local run (./mvnw spring-boot:run) — copy to .env or export in your shell
# Never commit real secrets

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/myservicedb?currentSchema=public
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_POSTGRES

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=CHANGE_ME_REDIS

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8085/realms/my-service-realm

KEYCLOAK_SERVER_URL=http://localhost:8085
KEYCLOAK_REALM=my-service-realm
KEYCLOAK_CLIENT_ID=my-service-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_VAULT_CLIENT_SECRET
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME_ADMIN
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

GRPC_CLIENT_CRYPTO_HOST=localhost
GRPC_CLIENT_CRYPTO_PORT=50051
